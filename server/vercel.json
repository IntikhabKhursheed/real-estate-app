{
  "version": 2,
  "builds": [
    {
      "src": "app.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/app.js"
    }
  ],
  "env": {
    "MONGODB_URI": "@MONGODB_URI",
    "JWT_SECRET": "@JWT_SECRET",
    "FRONTEND_ORIGIN": "@FRONTEND_ORIGIN",
    "GEMINI_API_KEY": "@GEMINI_API_KEY"
  }
}